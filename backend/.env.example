# ─── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-50-chars
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urlshortener

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── URL Shortener ─────────────────────────────────────────────────────────
# Base domain used when constructing short URLs (no trailing slash)
SHORT_URL_BASE_DOMAIN=http://localhost:8000
SHORT_URL_LENGTH=8

# ─── Email (optional — for future password-reset flows) ────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ─── Production overrides ──────────────────────────────────────────────────
# Uncomment and set when using config.settings.production:
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# SHORT_URL_BASE_DOMAIN=https://yourdomain.com
# DJANGO_SETTINGS_MODULE=config.settings.production
